{
  "name": "rvp",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names 9R,BE,FE --prefix-colors magenta,blue,green \"npm:dev:router\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:router": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\start-9router.ps1",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev -- --port 5173"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
